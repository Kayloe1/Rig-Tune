<Page
    x:Class="RigTune.App.Views.SystemCareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RigTune.App.Controls"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="System Care">
    <controls:ComingSoonPanel
        Title="System Care"
        Phase="Coming in a later build phase"
        Subtitle="Guided maintenance: restore points, cleanup, startup apps, Appx/winget and repair.">
        <controls:ComingSoonPanel.Features>
                <sys:String>Restore Points: cooldown-free creation with custom label, list with origin tags, open rstrui.exe</sys:String>
                <sys:String>System Cleanup: 7 user-confirmed actions with live reclaimable size</sys:String>
                <sys:String>Startup Apps via StartupApproved (entries stay visible in Task Manager)</sys:String>
                <sys:String>Appx bloatware manager + winget updater</sys:String>
                <sys:String>Repair &amp; Recovery status scanner</sys:String>
        </controls:ComingSoonPanel.Features>
    </controls:ComingSoonPanel>
</Page>
