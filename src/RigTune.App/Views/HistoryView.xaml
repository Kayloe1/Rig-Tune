<Page
    x:Class="RigTune.App.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:RigTune.Core.Models;assembly=RigTune.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:RigTune.App.ViewModels"
    x:Name="Root"
    Title="Backups, Drift &amp; History"
    d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="32,24,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,12,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Backups, Drift &amp; History" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Every change RigTune makes is snapshotted first. Revert one item or everything; the Windows Update Drift Detector arrives in a later phase." />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                    <ui:Button
                        Appearance="Danger"
                        Command="{Binding RevertAllCommand}"
                        Content="Revert All"
                        Icon="{ui:SymbolIcon ArrowUndo24}" />
                </StackPanel>
            </Grid>

            <ui:InfoBar
                Title="{Binding StatusTitle}"
                Margin="0,0,12,12"
                IsClosable="True"
                IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                Message="{Binding StatusMessage}"
                Severity="{Binding StatusSeverity}" />

            <ui:Card Style="{StaticResource HostCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="ACTIVE SNAPSHOTS" />
                    <TextBlock
                        Style="{StaticResource CardDetail}"
                        Text="No active changes — your system is in its original state."
                        Visibility="{Binding ActiveSnapshots.Count, Converter={StaticResource ZeroToVisible}}" />
                    <ItemsControl ItemsSource="{Binding ActiveSnapshots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SnapshotRow}">
                                <Border
                                    Margin="0,4"
                                    Padding="12,8"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding TweakId}" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Text="{Binding Target}"
                                                TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource CardDetail}">
                                                <Run Text="Original: " /><Run Text="{Binding Original, Mode=OneWay}" />
                                                <Run Text="  →  Applied: " /><Run Text="{Binding Applied, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource CardDetail}" Text="{Binding CapturedAt, StringFormat='Captured {0:yyyy-MM-dd HH:mm:ss}'}" />
                                            <TextBlock
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Style="{StaticResource CardDetail}"
                                                Text="{Binding LastError}"
                                                Visibility="{Binding LastError, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                        <ui:Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.RevertCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Revert"
                                            Icon="{ui:SymbolIcon ArrowUndo24}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource HostCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="AUDIT LOG (history.json)" />
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AuditEntry}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TimestampUtc.LocalDateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Text="{Binding Action}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Style="{StaticResource CardDetail}"
                                            Text="{Binding Details}"
                                            Visibility="{Binding Details, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
