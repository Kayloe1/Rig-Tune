<Page
    x:Class="RigTune.App.Views.TweaksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:RigTune.Core.Models;assembly=RigTune.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:RigTune.App.ViewModels"
    x:Name="Root"
    Title="Tweaks"
    d:DataContext="{d:DesignInstance Type=vm:TweaksViewModel}"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  Small rounded tag  -->
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  Status dot colour by TweakStatus  -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TweakStatus.Active}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TweakStatus.Partial}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TweakStatus.Informational}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TweakStatus.NotApplicable}">
                    <Setter Property="Fill" Value="Transparent" />
                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Filter pill  -->
        <Style x:Key="Pill" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Bd"
                            Padding="14,5"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <TextBlock
                                x:Name="Txt"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Converter={StaticResource FilterLabel}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="28,20,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Tweaks" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    Margin="0,0,12,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsLoadingStatus, Converter={StaticResource BoolToVisibility}}" />
                <ui:ToggleSwitch
                    Margin="0,0,16,0"
                    Content="Danger Zone"
                    IsChecked="{Binding IsDangerZoneEnabled, Mode=TwoWay}"
                    ToolTip="Off by default. Unlocks tweaks that can reduce security or break features." />
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding RefreshStatusesCommand}"
                    Content="Re-check"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
                <ui:Button
                    Appearance="Danger"
                    Command="{Binding RevertAllCommand}"
                    Content="Revert All Tweaks"
                    Icon="{ui:SymbolIcon ArrowUndo24}" />
            </StackPanel>
        </Grid>

        <!--  Search + filter pills  -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="Search tweaks, paths, services…"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <ListBox
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource Pill}"
                ItemsSource="{Binding Filters}"
                SelectedItem="{Binding Filter, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>

        <!--  Banners  -->
        <StackPanel Grid.Row="2">
            <ui:InfoBar
                Title="Danger Zone is ON"
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="{Binding IsDangerZoneEnabled}"
                Message="Danger Zone tweaks are unlocked. Each one asks to create a restore point first and can be reverted, but some reduce security or break WSL2, Windows Update or recovery."
                Severity="Warning" />
            <ui:InfoBar
                Title="{Binding StatusTitle}"
                Margin="0,0,0,8"
                IsClosable="True"
                IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                Message="{Binding StatusMessage}"
                Severity="{Binding StatusSeverity}" />
        </StackPanel>

        <!--  List + inspector drawer  -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="TweakList"
                ItemsSource="{Binding View}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Single"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                VirtualizingPanel.ScrollUnit="Pixel">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Grid Margin="4,18,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ItemCount, Mode=OneWay, StringFormat='  ({0})'}" />
                                    </TextBlock>
                                    <ui:Button
                                        Grid.Column="1"
                                        Padding="10,4"
                                        Appearance="Secondary"
                                        Command="{Binding DataContext.ApplyPresetCommand, ElementName=Root}"
                                        CommandParameter="{Binding Name}"
                                        Icon="{ui:SymbolIcon Checkmark24}"
                                        ToolTip="Applies this area's Recommended tweaks (never Danger Zone or permanent ones). You will be offered a restore point first."
                                        Visibility="{Binding Items, Converter={StaticResource RecommendedCount}}">
                                        <TextBlock>
                                            <Run Text="Apply Recommended (" /><Run Text="{Binding Items, Mode=OneWay, Converter={StaticResource RecommendedCount}}" /><Run Text=")" />
                                        </TextBlock>
                                    </ui:Button>
                                </Grid>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListViewItem}}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                        <Grid Margin="8,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Margin="0,5,0,0" VerticalAlignment="Top" Style="{StaticResource StatusDot}" />
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,6,0"
                                        FontSize="14"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Symbol="LockClosed24"
                                        ToolTip="Locked — enable the Danger Zone to use"
                                        Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" Style="{StaticResource Tag}" Visibility="{Binding IsDangerZone, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" Style="{StaticResource TagText}" Text="Danger Zone" />
                                    </Border>
                                    <Border Style="{StaticResource Tag}" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource TagText}" Text="Restart" />
                                    </Border>
                                    <Border Style="{StaticResource Tag}" Visibility="{Binding UndoTag, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock Style="{StaticResource TagText}" Text="{Binding UndoTag}" />
                                    </Border>
                                    <Border Style="{StaticResource Tag}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource TagText}" Text="Recommended" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding StatusText}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                <ui:ProgressRing
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button
                                    Padding="10,4"
                                    Appearance="Primary"
                                    Command="{Binding DataContext.ApplyCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding ApplyLabel}"
                                    IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}" />
                                <ui:Button
                                    Margin="6,0,0,0"
                                    Padding="10,4"
                                    Command="{Binding DataContext.RevertCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="Revert"
                                    Visibility="{Binding HasActiveSnapshots, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Inspector drawer  -->
            <ui:Card
                Grid.Column="1"
                Width="440"
                Margin="12,0,0,0"
                Padding="0"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer Padding="18" VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Selected.Name}" TextWrapping="Wrap" />
                            <ui:Button
                                Grid.Column="1"
                                Padding="6"
                                Appearance="Transparent"
                                Command="{Binding CloseInspectorCommand}"
                                Icon="{ui:SymbolIcon Dismiss24}"
                                ToolTip="Close" />
                        </Grid>
                        <TextBlock Style="{StaticResource CardDetail}" Text="{Binding Selected.GroupKey}" />
                        <TextBlock Margin="0,12,0,0" Text="{Binding Selected.Description}" TextWrapping="Wrap" />

                        <ui:InfoBar
                            Title="Before you apply"
                            Margin="0,12,0,0"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{Binding Selected.Warning}"
                            Severity="Warning"
                            Visibility="{Binding Selected.Warning, Converter={StaticResource NullToCollapsed}}" />

                        <!--  Live status  -->
                        <TextBlock Margin="0,16,0,6" Style="{StaticResource CardTitle}" Text="LIVE STATUS" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse DataContext="{Binding Selected}" Margin="0,0,8,0" Style="{StaticResource StatusDot}" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding Selected.StatusText}" />
                            <ui:ProgressRing
                                Width="14"
                                Height="14"
                                Margin="8,0,0,0"
                                IsIndeterminate="True"
                                Visibility="{Binding IsInspectorLoading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Selected.ActionStates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:ActionState}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="Bold" Text="{Binding Status, Converter={StaticResource ActionStatusLabel}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontFamily="Consolas" FontSize="11.5" Text="{Binding Target}" TextWrapping="Wrap" />
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                                <Run Text="{Binding Current, Mode=OneWay}" />
                                                <Run Text="{Binding Expected, Mode=OneWay, StringFormat='→ {0}'}" />
                                            </TextBlock>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding Note}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Exact target  -->
                        <TextBlock Margin="0,16,0,6" Style="{StaticResource CardTitle}" Text="EXACT TARGET" />
                        <Border
                            Padding="10,8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock FontFamily="Consolas" FontSize="11.5" Text="{Binding Selected.TargetSummary}" TextWrapping="Wrap" />
                        </Border>
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button
                                Margin="0,0,6,6"
                                Command="{Binding CopyPathCommand}"
                                CommandParameter="{Binding Selected.TargetSummary}"
                                Content="Copy path"
                                Icon="{ui:SymbolIcon Copy24}" />
                            <ui:Button
                                Margin="0,0,6,6"
                                Command="{Binding OpenInRegeditCommand}"
                                CommandParameter="{Binding Selected}"
                                Content="Open in regedit"
                                Icon="{ui:SymbolIcon Open24}"
                                Visibility="{Binding Selected.HasRegistryTarget, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            <ui:Button
                                Margin="0,0,6,6"
                                Command="{Binding OpenServicesCommand}"
                                Content="Open services.msc"
                                Icon="{ui:SymbolIcon Open24}"
                                Visibility="{Binding Selected.HasServiceTarget, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                        </WrapPanel>

                        <!--  Options  -->
                        <StackPanel Visibility="{Binding Options.Count, Converter={StaticResource NonZeroToVisible}}">
                            <TextBlock Margin="0,12,0,6" Style="{StaticResource CardTitle}" Text="SETTING" />
                            <ComboBox
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Options}"
                                SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource CardDetail}" Text="{Binding SelectedOption.Description}" />
                        </StackPanel>

                        <!--  Sliders  -->
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Sliders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SliderItem}">
                                    <StackPanel Margin="0,6">
                                        <Grid>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                            <TextBlock HorizontalAlignment="Right">
                                                <Run Text="{Binding Value, Mode=OneWay, StringFormat='{}{0:0}'}" />
                                                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Unit, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding Max}"
                                            Minimum="{Binding Min}"
                                            TickFrequency="{Binding Step}"
                                            Value="{Binding Value, Mode=TwoWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Interactive panels  -->
                        <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource CardDetail}"
                            Text="{Binding InteractiveHint}"
                            Visibility="{Binding InteractiveHint, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding HardwareChecks}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HardwareChecks, Converter={StaticResource NullToCollapsed}}" />

                        <ItemsControl
                            Margin="0,8,0,0"
                            ItemsSource="{Binding Selectables}"
                            Visibility="{Binding ShowSelectables, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SelectableItem}">
                                    <CheckBox Margin="0,2" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                <Border Style="{StaticResource Tag}" Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}">
                                                    <TextBlock Style="{StaticResource TagText}" Text="{Binding Badge}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding ShowCores, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Margin="0,12,0,6" Style="{StaticResource CardTitle}" Text="CPU CORES (P = Performance · E = Efficient)" />
                            <ItemsControl ItemsSource="{Binding Cores}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CoreItem}">
                                        <ToggleButton
                                            Width="46"
                                            Margin="0,0,4,4"
                                            Padding="0,4"
                                            Content="{Binding Label}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                            ToolTip="{Binding Tooltip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowPriority, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Margin="0,12,0,6" Style="{StaticResource CardTitle}" Text="DEVICE INTERRUPT PRIORITY" />
                            <ComboBox
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding PriorityChoices}"
                                SelectedItem="{Binding SelectedPriority, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowStateChoices, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Margin="0,12,0,6" Style="{StaticResource CardTitle}" Text="VALUE TO SET" />
                            <ComboBox
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding StateChoices}"
                                SelectedItem="{Binding SelectedState, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowExpert, Converter={StaticResource BoolToVisibility}}">
                            <Expander Margin="0,12,0,0" Header="Expert view — processor power settings (active plan)">
                                <ItemsControl ItemsSource="{Binding ExpertSettings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:PowerSettingInfo}">
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="12" Text="{Binding FriendlyName}" TextWrapping="Wrap" />
                                                    <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Setting}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" FontSize="12" TextAlignment="Right">
                                                    <Run Text="{Binding AcValue, Mode=OneWay, StringFormat='AC {0}'}" />
                                                    <Run Text="{Binding DcValue, Mode=OneWay, StringFormat=' · DC {0}'}" />
                                                    <LineBreak />
                                                    <Run Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding IsHidden, Mode=OneWay, StringFormat='hidden: {0}'}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>

                        <!--  Undo note + actions  -->
                        <TextBlock Margin="0,16,0,6" Style="{StaticResource CardTitle}" Text="UNDO" />
                        <TextBlock Style="{StaticResource CardDetail}" Text="{Binding Selected.UndoNote}" />
                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding ApplyCommand}"
                                CommandParameter="{Binding Selected}"
                                Content="{Binding Selected.ApplyLabel}"
                                Icon="{ui:SymbolIcon Checkmark24}"
                                IsEnabled="{Binding Selected.IsLocked, Converter={StaticResource InverseBool}}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding RevertCommand}"
                                CommandParameter="{Binding Selected}"
                                Content="Revert to original"
                                Icon="{ui:SymbolIcon ArrowUndo24}"
                                Visibility="{Binding Selected.CanRevert, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
