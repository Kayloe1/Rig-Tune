<Page
    x:Class="RigTune.App.Views.AppOptimizerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:RigTune.App.ViewModels"
    x:Name="Root"
    Title="App Optimizer"
    d:DataContext="{d:DesignInstance Type=vm:AppOptimizerViewModel}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="CategoryPill" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="14,5" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14">
                            <TextBlock x:Name="Txt" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" BasedOn="{StaticResource CardTitle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
    </Page.Resources>

    <Grid Margin="28,20,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="App Optimizer" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:ProgressRing Width="18" Height="18" Margin="0,0,12,0" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <ui:ToggleSwitch Margin="0,0,16,0" Content="Show all profiles" IsChecked="{Binding ShowAll, Mode=TwoWay}" ToolTip="Show the profiles of apps that are not installed on this PC" />
                <ui:Button Margin="0,0,8,0" Command="{Binding RefreshCommand}" Content="Re-detect" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                <ui:Button Appearance="Primary" Command="{Binding AddCustomAppCommand}" Content="Add Custom App" Icon="{ui:SymbolIcon Add24}" />
            </StackPanel>
        </Grid>

        <ListBox
            Grid.Row="1"
            Margin="0,14,0,4"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource CategoryPill}"
            ItemsSource="{Binding Categories}"
            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <ui:InfoBar Grid.Row="2" Margin="0,0,0,8" Title="{Binding StatusTitle}" IsClosable="True" IsOpen="{Binding IsStatusOpen, Mode=TwoWay}" Message="{Binding StatusMessage}" Severity="{Binding StatusSeverity}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding View}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AppCardViewModel}">
                        <ui:CardExpander Margin="0,0,8,8" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Symbol="CheckmarkCircle24" ToolTip="{Binding Evidence}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Margin="6,0,0,0" Padding="8,3" Command="{Binding DataContext.EditCustomAppCommand, ElementName=Root}" CommandParameter="{Binding}" Content="Edit" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Margin="6,0,0,0" Padding="8,3" Appearance="Danger" Command="{Binding DataContext.DeleteCustomAppCommand, ElementName=Root}" CommandParameter="{Binding}" Content="Delete" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </ui:CardExpander.Header>

                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Evidence, StringFormat='Detected: {0}'}" TextWrapping="Wrap" Visibility="{Binding Evidence, Converter={StaticResource NullToCollapsed}}" />

                                <!--  Caches  -->
                                <StackPanel Visibility="{Binding HasCaches, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="CACHE CLEANUP" />
                                    <ItemsControl ItemsSource="{Binding Caches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AppCacheItemViewModel}">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox x:Name="Check" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SizeText}" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSensitive}" Value="True">
                                                        <Setter TargetName="Check" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Setter TargetName="Check" Property="ToolTip" Value="Deleting cookies or history signs you out of websites. Unchecked by default." />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding CacheTotal}" />
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:Button Padding="10,4" Command="{Binding ScanCommand}" Content="Re-scan" />
                                            <ui:Button Margin="6,0,0,0" Padding="10,4" Appearance="Primary" Command="{Binding CleanCommand}" Content="Clean selected" Icon="{ui:SymbolIcon Broom24}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!--  Toggles  -->
                                <StackPanel Visibility="{Binding HasToggles, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="REVERSIBLE SETTINGS" />
                                    <ItemsControl ItemsSource="{Binding Toggles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AppToggleItemViewModel}">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Description}" TextWrapping="Wrap" Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}" />
                                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Warning}" TextWrapping="Wrap" Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                        <ui:ProgressRing Width="14" Height="14" Margin="0,0,6,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                                        <ui:Button Padding="10,4" Appearance="Primary" Command="{Binding DataContext.ApplyToggleCommand, RelativeSource={RelativeSource AncestorType=ui:CardExpander}}" CommandParameter="{Binding}" Content="Apply" IsEnabled="{Binding CanApply}" />
                                                        <ui:Button Margin="6,0,0,0" Padding="10,4" Command="{Binding DataContext.RevertToggleCommand, RelativeSource={RelativeSource AncestorType=ui:CardExpander}}" CommandParameter="{Binding}" Content="Revert" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!--  While You Play  -->
                                <TextBlock Style="{StaticResource SectionTitle}" Text="WHILE YOU PLAY (GAME MODE)" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:ToggleSwitch Content="Throttle while a game runs" IsChecked="{Binding WhilePlayingEnabled, Mode=TwoWay}" />
                                    <ComboBox Width="160" Margin="12,0,0,0" ItemsSource="{Binding Modes}" SelectedItem="{Binding WhilePlayingMode, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CardDetail}" Text="{Binding WhilePlayingHint}" />
                            </StackPanel>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
