<UserControl
    x:Class="RigTune.App.Controls.ComingSoonPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root">
    <ScrollViewer Padding="32,24,32,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title, ElementName=Root}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Subtitle, ElementName=Root}" />

            <ui:Card Margin="0,24,0,0" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,10,0"
                            FontSize="20"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Symbol="Clock24" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding Phase, ElementName=Root}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Planned for this module:"
                        TextWrapping="Wrap" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Features, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Text="•" />
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
